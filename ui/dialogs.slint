import { Theme } from "theme.slint";
import { ActionButton, SliderRow } from "components.slint";

export component ConfirmDialog inherits Rectangle {
    in property <bool> is_open: false;
    in property <string> title: "Confirm Overwrite";
    in property <string> message: "A file with this name already exists. Overwrite original file?";

    callback confirmed();
    callback cancelled();

    if (root.is_open) : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        z: 110;

        Rectangle {
            width: 440px;
            height: 190px;
            border-radius: Theme.radius_lg;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: root.title;
                    color: Theme.text_primary;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: root.message;
                    color: Theme.text_secondary;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Rectangle {}

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    ActionButton {
                        text: "Cancel";
                        min_btn_width: 80px;
                        clicked => { root.cancelled(); }
                    }

                    ActionButton {
                        text: "Overwrite";
                        danger: true;
                        min_btn_width: 90px;
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
    }
}

export component ToastNotification inherits Rectangle {
    in property <bool> is_shown: false;
    in property <string> message: "";
    in property <bool> is_error: false;

    callback dismissed();

    width: 100%;
    height: 100%;
    z: 200;
    visible: root.is_shown;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 60px;
        height: 36px;
        min-width: 260px;
        border-radius: Theme.radius_md;
        background: root.is_error ? #991B1B : (Theme.dark_mode ? #22252C : #FFFFFF);
        border-width: 1px;
        border-color: root.is_error ? #DC2626 : Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: center;
            spacing: 8px;

            Text {
                text: root.message;
                color: root.is_error ? #FEE2E2 : Theme.text_primary;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }

            TouchArea {
                width: 18px;
                height: 18px;
                mouse-cursor: pointer;
                clicked => { root.dismissed(); }

                Text {
                    text: "✕";
                    color: root.is_error ? #FCA5A5 : Theme.text_muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
