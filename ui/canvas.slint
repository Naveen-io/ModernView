import { Theme } from "theme.slint";
import { Checkerboard } from "checkerboard.slint";

export component Canvas inherits Rectangle {
    in property <image> image_source;
    in property <length> img_width: 800px;
    in property <length> img_height: 600px;
    in property <float> zoom: 1.0;
    in property <length> pan_offset_x: 0px;
    in property <length> pan_offset_y: 0px;
    in property <bool> is_crop_active: false;
    in property <bool> is_loading: false;

    // Crop box coordinates relative to displayed image (0.0 to 1.0)
    in-out property <float> crop_x: 0.1;
    in-out property <float> crop_y: 0.1;
    in-out property <float> crop_w: 0.8;
    in-out property <float> crop_h: 0.8;

    callback zoom_in();
    callback zoom_out();
    callback reset_view();
    callback pan_delta(length, length);
    callback crop_changed(float, float, float, float);

    clip: true;
    background: Theme.bg;

    // Checkerboard background
    Checkerboard {
        width: 100%;
        height: 100%;
    }

    // TouchArea for mouse wheel zoom and pan drag
    canvas_touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: self.pressed ? grabbing : (root.zoom > 1.0 ? grab : default);

        property <length> drag_start_x: 0px;
        property <length> drag_start_y: 0px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                drag_start_x = self.mouse-x;
                drag_start_y = self.mouse-y;
            }
        }

        moved => {
            if (self.pressed && !root.is_crop_active) {
                let dx = self.mouse-x - drag_start_x;
                let dy = self.mouse-y - drag_start_y;
                drag_start_x = self.mouse-x;
                drag_start_y = self.mouse-y;
                root.pan_delta(dx, dy);
            }
        }

        scroll-event(event) => {
            if (event.delta-y > 0) {
                root.zoom_in();
            } else if (event.delta-y < 0) {
                root.zoom_out();
            }
            return EventResult.accept;
        }

        double-clicked => {
            root.reset_view();
        }
    }

    // Container centered in canvas, transformed by pan and zoom
    viewport_container := Rectangle {
        x: (parent.width - self.width) / 2 + root.pan_offset_x;
        y: (parent.height - self.height) / 2 + root.pan_offset_y;
        width: root.img_width * root.zoom;
        height: root.img_height * root.zoom;
        background: #00000002;

        // Drop shadow for the image canvas
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.dark_mode ? #00000080 : #00000020;
        drop-shadow-offset-y: 4px;

        img_elem := Image {
            width: 100%;
            height: 100%;
            source: root.image_source;
            image-fit: fill;
        }

        // Crop overlay rectangle
        if (root.is_crop_active) : Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;

            // Dim outside crop
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                background: #00000088;
            }

            // Cutout crop box
            crop_box := Rectangle {
                x: parent.width * root.crop_x;
                y: parent.height * root.crop_y;
                width: parent.width * root.crop_w;
                height: parent.height * root.crop_h;
                border-width: 2px;
                border-color: #FFFFFF;
                background: #00000000;

                // Rule of thirds grid lines
                Rectangle {
                    x: parent.width / 3;
                    width: 1px;
                    height: 100%;
                    background: #FFFFFF40;
                }
                Rectangle {
                    x: parent.width * 2 / 3;
                    width: 1px;
                    height: 100%;
                    background: #FFFFFF40;
                }
                Rectangle {
                    y: parent.height / 3;
                    height: 1px;
                    width: 100%;
                    background: #FFFFFF40;
                }
                Rectangle {
                    y: parent.height * 2 / 3;
                    height: 1px;
                    width: 100%;
                    background: #FFFFFF40;
                }

                // Handles (Top-Left, Top-Right, Bottom-Left, Bottom-Right)
                Rectangle {
                    x: -5px; y: -5px; width: 10px; height: 10px;
                    background: #FFFFFF; border-radius: 2px;
                }
                Rectangle {
                    x: parent.width - 5px; y: -5px; width: 10px; height: 10px;
                    background: #FFFFFF; border-radius: 2px;
                }
                Rectangle {
                    x: -5px; y: parent.height - 5px; width: 10px; height: 10px;
                    background: #FFFFFF; border-radius: 2px;
                }
                Rectangle {
                    x: parent.width - 5px; y: parent.height - 5px; width: 10px; height: 10px;
                    background: #FFFFFF; border-radius: 2px;
                }
            }
        }
    }

    // Loading indicator
    if (root.is_loading) : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;

        Rectangle {
            width: 140px;
            height: 44px;
            border-radius: Theme.radius_md;
            background: Theme.surface_elevated;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "Loading image...";
                    color: Theme.text_primary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
