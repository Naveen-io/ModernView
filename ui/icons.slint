import { Theme } from "theme.slint";

export component IconChevronLeft inherits Rectangle {
    in property <color> icon_color: Theme.text_primary;
    width: 18px;
    height: 18px;
    Path {
        width: 100%;
        height: 100%;
        stroke: root.icon_color;
        stroke-width: 2px;
        commands: "M 12 4 L 6 9 L 12 14";
    }
}

