import { Theme } from "theme.slint";

export component IconButton inherits Rectangle {
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <length> button_size: 32px;
    in property <string> tooltip: "";

    callback clicked();

    width: root.button_size;
    height: root.button_size;
    border-radius: Theme.radius_md;
    background: root.disabled ? #00000000 : (
        touch.pressed ? (Theme.dark_mode ? #32353D : #DCDCE2) : (
            root.active ? (Theme.dark_mode ? #2C2F36 : #E5E7EB) : (
                touch.has-hover ? (Theme.dark_mode ? #25272D : #F0F0F4) : #00000000
            )
        )
    );
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? Theme.border : #00000000;

    animate background { duration: 120ms; easing: ease-out; }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => { root.clicked(); }
    }

    @children
}

export component ActionButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    in property <length> min_btn_width: 72px;

    callback clicked();

    height: 30px;
    min-width: root.min_btn_width;
    border-radius: Theme.radius_md;
    background: root.disabled ? (Theme.dark_mode ? #22242A : #EAEAEA) : (
        root.danger ? (touch.pressed ? #DC2626 : (touch.has-hover ? #EF4444 : #B91C1C)) : (
            root.primary ? (touch.pressed ? Theme.accent_active : (touch.has-hover ? Theme.accent_hover : Theme.accent)) : (
                touch.pressed ? (Theme.dark_mode ? #2A2D35 : #DCDCE2) : (touch.has-hover ? (Theme.dark_mode ? #24272E : #EAEAEF) : (Theme.dark_mode ? #1E2026 : #F3F3F6))
            )
        )
    );
    border-width: (root.primary || root.danger) ? 0px : 1px;
    border-color: Theme.border;

    animate background { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 6px;

        @children

        Text {
            text: root.text;
            color: root.disabled ? Theme.text_muted : (
                (root.primary || root.danger) ? #FFFFFF : Theme.text_primary
            );
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

export component SegmentButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> selected: false;

    callback clicked();

    height: 28px;
    border-radius: Theme.radius_sm;
    background: root.selected ? (Theme.dark_mode ? #2C2F36 : #FFFFFF) : (
        touch.has-hover ? (Theme.dark_mode ? #22252B : #F0F0F4) : #00000000
    );
    drop-shadow-blur: root.selected ? 3px : 0px;
    drop-shadow-color: root.selected ? (Theme.dark_mode ? #00000040 : #00000015) : #00000000;
    drop-shadow-offset-y: root.selected ? 1px : 0px;

    animate background { duration: 120ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 6px;

        @children

        Text {
            text: root.text;
            color: root.selected ? Theme.text_primary : Theme.text_secondary;
            font-size: 12px;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> text: "";
    in property <color> badge_color: Theme.surface_elevated;
    in property <color> text_color: Theme.text_secondary;

    height: 20px;
    border-radius: Theme.radius_sm;
    background: root.badge_color;
    border-width: 1px;
    border-color: Theme.border_subtle;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;

        Text {
            text: root.text;
            color: root.text_color;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component SliderRow inherits Rectangle {
    in property <string> label: "";
    in property <float> value: 0.0;
    in property <float> min_val: -100.0;
    in property <float> max_val: 100.0;
    in property <float> default_val: 0.0;
    in property <string> suffix: "";

    callback value_changed(float);
    callback reset_clicked();

    height: 38px;
    background: #00000000;

    VerticalLayout {
        spacing: 4px;

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: root.label;
                color: Theme.text_secondary;
                font-size: 12px;
                font-weight: 500;
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: Math.round(root.value) + root.suffix;
                    color: Theme.text_primary;
                    font-size: 12px;
                    font-weight: 600;
                }

                TouchArea {
                    width: 16px;
                    height: 16px;
                    mouse-cursor: pointer;
                    clicked => { root.reset_clicked(); }

                    Text {
                        text: "↺";
                        color: Theme.text_muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Slider track
        track := Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.dark_mode ? #282A30 : #DFDFE3;

            // Fill bar
            Rectangle {
                x: (root.min_val < 0.0) ? (
                    (root.value >= 0.0) ? track.width / 2 :
                    track.width * ((root.value - root.min_val) / (root.max_val - root.min_val))
                ) : 0px;
                width: (root.min_val < 0.0) ? (
                    Math.abs(root.value) / (root.max_val - root.min_val) * track.width
                ) : (
                    track.width * ((root.value - root.min_val) / (root.max_val - root.min_val))
                );
                height: 100%;
                border-radius: 2px;
                background: Theme.accent;
            }

            // Thumb
            thumb := Rectangle {
                x: (track.width - 12px) * Math.max(0.0, Math.min(1.0, (root.value - root.min_val) / (root.max_val - root.min_val)));
                y: -4px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #FFFFFF;
                border-width: 1px;
                border-color: Theme.accent;
                drop-shadow-blur: 2px;
                drop-shadow-color: #00000030;
            }

            slider_touch := TouchArea {
                width: 100%;
                height: 20px;
                y: -8px;
                mouse-cursor: pointer;

                moved => {
                    if (self.pressed) {
                        root.update_val_from_x(self.mouse-x);
                    }
                }

                clicked => {
                    root.update_val_from_x(self.mouse-x);
                }
            }
        }
    }

    function update_val_from_x(mouse_x: length) {
        let ratio = Math.max(0.0, Math.min(1.0, mouse_x / track.width));
        let new_val = root.min_val + ratio * (root.max_val - root.min_val);
        root.value_changed(new_val);
    }
}
